#!/sbin/openrc-run

name="pythonos-gui"
description="PythonOS graphical desktop session"
command="/usr/bin/pythonos-gui"
command_background="no"

# The console demo and self-test own tty1 while they run. In a normal native
# boot, Xorg uses vt7 and the shared PySide6 desktop is the visible session.
depend()
{
    need pythonos
    after pythonos
}
