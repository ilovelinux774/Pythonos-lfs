#!/bin/sh
# Start the shared Python desktop inside Alpine's Xorg session.
# Self-test/demo modes are serial/VGA console programs and must not compete
# with their screenshot console.
case " $(cat /proc/cmdline 2>/dev/null) " in
    *" pythonos.selftest=1 "*|*" pythonos.demo=1 "*)
        exit 0
        ;;
esac

export HOME=/root
export USER=root
export LOGNAME=root
export PYTHONOS_HOME=/root/.pythonos
export PYTHONPATH=/usr/lib:/usr/lib/pythonos
export QT_QPA_PLATFORM=xcb
exec /usr/bin/startx /usr/bin/python3 /usr/lib/pythonos/native_desktop.py \
    -- :0 vt7 -nolisten tcp
